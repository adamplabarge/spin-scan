{
  "name": "spin-scan",
  "author": "Adam LaBarge <adamplabarge@gmail.com>",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamplabarge/spin-scan.git"
  },
  "description": "Scan the label of a rotating cylinder (e.g. a medication bottle) from a camera or video and stitch it into a single flat image.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "spin-scan.png",
    "LICENSE"
  ],
  "keywords": [
    "cylinder",
    "unwrap",
    "panorama",
    "stitching",
    "label",
    "scanner",
    "camera",
    "medication",
    "react",
    "nextjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node scripts/serve.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "semantic-release",
    "demo:https": "npm run build && node scripts/serve.mjs --https"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  }
}
